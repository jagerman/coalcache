[Unit]
Description=Multi-chain caching and coalescing RPC proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Any unprivileged user will do: coalcache writes no files.
User=coalcache
ExecStart=/usr/local/bin/coalcache --config /etc/coalcache.conf
Restart=always
RestartSec=5s

# Needed only to listen on a port below 1024:
#AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
